<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>How to Fish - Roulette Operator</AssemblyName>
    <RootNamespace>HowToFish.RouletteTrainer.App</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\roulette-fish-pixel.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <EmbeddedResource Include="Assets\roulette-fish-pixel.png" LogicalName="RouletteFishPixel.png" />
  </ItemGroup>
</Project>
